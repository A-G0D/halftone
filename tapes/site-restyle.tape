# Site restyle: a Dev desk cycling through all eleven themes with t.
Output tapes/out/site-restyle-frames/
Set Shell zsh
Set FontFamily "JetBrains Mono"
Set FontSize 18
Set Width 1920
Set Height 1240
Set Padding 0
Set Framerate 30
Set TypingSpeed 0
Set CursorBlink false
Hide
Type 'sh tapes/site-prep.sh restyle; export COLORTERM=truecolor HALFTONE_DEMO=1 HALFTONE_MUTE=1 HALFTONE_CITY="San Francisco" HALFTONE_ZONES="America/Los_Angeles Europe/London Asia/Tokyo" HALFTONE_REPOS=$TMPDIR/hw/site/repos HALFTONE_CONFIG=$TMPDIR/hw/site/restyle/desk.conf ZDOTDIR=$TMPDIR/hw/z; clear && ./target/release/halftone'
Enter
Sleep 1s
Show
Sleep 6s
Type "t"
Sleep 1.2s
Type "t"
Sleep 1.2s
Type "t"
Sleep 1.2s
Type "t"
Sleep 1.2s
Type "t"
Sleep 1.2s
Type "t"
Sleep 1.2s
Type "t"
Sleep 1.2s
Type "t"
Sleep 1.2s
Type "t"
Sleep 1.2s
Type "t"
Sleep 1.2s
Type "t"
Sleep 2s
Screenshot tapes/out/site-restyle.png
Hide
Type "q"
