# The layout editor: pick a card, move it, resize it, add a terminal, save.
Output tapes/out/edit.mp4
Set Shell zsh
Set FontFamily "JetBrains Mono"
Set FontSize 18
Set Width 1920
Set Height 1240
Set Padding 0
Set Framerate 30
Set TypingSpeed 0
Set CursorBlink false
Hide
Type 'export COLORTERM=truecolor HALFTONE_DEMO=1 HALFTONE_MUTE=1 HALFTONE_CONFIG=$TMPDIR/hw/edit.conf HALFTONE_TERM_CWD=$TMPDIR/hwrepo ZDOTDIR=$TMPDIR/hw/z; cp $TMPDIR/hw/demo.conf $TMPDIR/hw/edit.conf; clear && ./target/release/halftone'
Enter
Sleep 1.5s
Show
Type "e"
Sleep 1s
Right
Sleep 0.5s
Right
Sleep 0.5s
Right
Sleep 0.7s
Type "h"
Sleep 0.9s
Type "+"
Sleep 0.5s
Type "+"
Sleep 0.9s
Type "a"
Sleep 0.6s
Down
Sleep 0.25s
Down
Sleep 0.25s
Down
Sleep 0.25s
Down
Sleep 0.25s
Down
Sleep 0.25s
Down
Sleep 0.6s
Enter
Sleep 1.2s
Screenshot tapes/out/edit-mid.png
Type "e"
Sleep 3s
Screenshot tapes/out/edit-done.png
Hide
Type "q"
