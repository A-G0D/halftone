#!/bin/sh
# about: CPU, memory, disk and battery
# group: System
# CPU load, memory, disk, battery. macOS: sysctl, vm_stat, pmset. Linux: /proc.
echo "title: System"; echo "every: 5"
cores=$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)
if [ -r /proc/loadavg ]; then
  load=$(cut -d' ' -f1 /proc/loadavg)
  mem=$(awk '/MemTotal/{t=$2}/MemAvailable/{a=$2}END{if(t)printf "%.2f",(t-a)/t}' /proc/meminfo)
else
  load=$(sysctl -n vm.loadavg 2>/dev/null | awk '{print $2}')
  mem=$(vm_stat 2>/dev/null | awk -v t="$(sysctl -n hw.memsize 2>/dev/null)" '/page size of/{p=$8}/Pages active|Pages wired|occupied by compressor/{u+=$NF}END{if(t&&p)printf "%.2f",u*p/t}')
fi
pct=$(awk -v l="${load:-0}" -v c="$cores" 'BEGIN{v=l/c;if(v>1)v=1;printf "%.2f",v}')
tone=good
awk -v p="$pct" 'BEGIN{exit !(p>0.5)}' && tone=warn
awk -v p="$pct" 'BEGIN{exit !(p>0.8)}' && tone=bad
echo "bar: CPU load ${load:-?} | $pct | $tone"
[ -n "$mem" ] && echo "bar: Memory | $mem | accent"
# macOS: / is the small sealed system volume; the APFS container is what Finder calls the disk.
if command -v diskutil >/dev/null; then
  disk=$(diskutil info / 2>/dev/null | awk -F'[()]' '/Container Total Space/{split($2,a," ");t=a[1]}/Container Free Space/{split($2,a," ");f=a[1]}END{if(t)printf "%.2f %.0f %.0f",(t-f)/t,(t-f)/1e9,t/1e9}')
else
  disk=$(df -k / | awk 'NR==2{printf "%.2f %.0f %.0f",$3/$2,$3/1e6,$2/1e6}')
fi
if [ -n "$disk" ]; then
  set -- $disk
  t=muted; awk -v p="$1" 'BEGIN{exit !(p>0.85)}' && t=warn; awk -v p="$1" 'BEGIN{exit !(p>0.95)}' && t=bad
  echo "bar: Disk $2 of $3 GB | $1 | $t"
fi
bat=""
if command -v pmset >/dev/null; then
  bat=$(pmset -g batt | awk -F'\t' '/InternalBattery/{split($2,a,";");gsub(/%/,"",a[1]);gsub(/^ /,"",a[2]);print a[1]"|"a[2]}')
elif [ -r /sys/class/power_supply/BAT0/capacity ]; then
  bat="$(cat /sys/class/power_supply/BAT0/capacity)|$(cat /sys/class/power_supply/BAT0/status)"
fi
if [ -n "$bat" ]; then
  p=${bat%%|*}; st=${bat#*|}
  t=good; [ "$p" -lt 20 ] && t=bad
  awk -v p="$p" -v t="$t" -v s="$st" 'BEGIN{printf "bar: Battery %s | %.2f | %s\n", s, p/100, t}'
fi
