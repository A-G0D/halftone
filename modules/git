#!/bin/sh
# about: Uncommitted and unpushed work across your repos
# group: Dev
# Uncommitted and unpushed work across your repos. Roots: $HALFTONE_REPOS (space separated), else
# ~/code ~/src ~/projects, else any repo up to three folders deep in your home (found once an hour).
echo "title: Git"; echo "every: 120"
command -v git >/dev/null || { echo "text: needs git"; exit 0; }
cache="${TMPDIR:-/tmp}/halftone-git-repos"
repos() {
  if [ -n "$HALFTONE_REPOS" ]; then for r in $HALFTONE_REPOS; do ls -d "$r"/*/.git 2>/dev/null; done; return; fi
  ls -d "$HOME"/code/*/.git "$HOME"/src/*/.git "$HOME"/projects/*/.git 2>/dev/null && return
  if [ -z "$(find "$cache" -mmin -60 2>/dev/null)" ]; then
    find "$HOME" -maxdepth 4 -name .git -type d -not -path "$HOME/Library/*" -not -path "*/node_modules/*" -not -path "$HOME/.*" 2>/dev/null > "$cache"
  fi
  cat "$cache"
}
n=0 clean=0
for g in $(repos | tr ' ' '?'); do
  d=$(dirname "$(printf %s "$g" | tr '?' ' ')")
  dirty=$(git -C "$d" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  ahead=$(git -C "$d" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
  if [ "$dirty" -eq 0 ] && [ "$ahead" -eq 0 ]; then clean=$((clean+1)); continue; fi
  t=warn; [ "$dirty" -eq 0 ] && t=accent
  note=""; [ "$dirty" -gt 0 ] && note="$dirty changed"; [ "$ahead" -gt 0 ] && note="${note:+$note · }$ahead to push"
  echo "row: $(basename "$d") | $note | $t"
  n=$((n+1)); [ $n -ge 12 ] && break
done
[ $n -eq 0 ] && [ $clean -eq 0 ] && echo "text: no repos found · set HALFTONE_REPOS=\"~/code ~/work\""
[ $clean -gt 0 ] && echo "text: $clean more all clean"
exit 0
