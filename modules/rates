#!/bin/sh
# about: US Treasury yields: 13-week, 10-year, 30-year
# group: Finance
# Yahoo chart API, no key: https://query1.finance.yahoo.com/v8/finance/chart/^TNX?interval=5m&range=1d (value is the yield in %)
echo "title: US rates"; echo "every: 300"
command -v curl >/dev/null || { echo "text: needs curl"; exit 0; }
L="^IRX:13-week ^TNX:10-year ^TYX:30-year"
d=$(mktemp -d) || exit 0; trap 'rm -rf "$d"' EXIT
i=0; for p in $L; do i=$((i+1))
  ( curl -sf -m 6 -A Mozilla/5.0 "https://query1.finance.yahoo.com/v8/finance/chart/${p%%:*}?interval=5m&range=1d" |
    sed -n 's/.*"regularMarketPrice":\([0-9.]*\).*"chartPreviousClose":\([0-9.]*\).*/\1 \2/p' > "$d/$i" ) &
done; wait
echo "open: https://finance.yahoo.com/bonds"
i=0; ok=0; for p in $L; do i=$((i+1))
  v=$(cat "$d/$i" 2>/dev/null); [ -z "$v" ] && continue; ok=1
  # change is in percentage points; falling yields shown green
  echo "$v" | awk -v n="${p#*:}" '{c=$1-$2; printf "row: %s | %.3f%%  %+.3f | %s\n", n, $1, c, (c>0)?"bad":"good"}'
done
[ $ok = 1 ] || echo "error: yahoo finance unreachable"
exit 0
