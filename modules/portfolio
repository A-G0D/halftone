#!/bin/sh
# about: Your holdings from ~/.config/halftone/portfolio.txt: value, day change, total P/L
# group: Finance
# Yahoo chart API, no key: https://query1.finance.yahoo.com/v8/finance/chart/<SYM>?interval=5m&range=1d
echo "title: Portfolio"; echo "every: 60"
command -v curl >/dev/null || { echo "text: needs curl"; exit 0; }
f="${HALFTONE_PORTFOLIO:-$HOME/.config/halftone/portfolio.txt}"
if [ ! -f "$f" ]; then
  mkdir -p "$(dirname "$f")" && cat > "$f" <<'EOF'
# one holding per line: SYMBOL quantity [cost per share]
# AAPL 10 150.25
# BTC-USD 0.5 30000
EOF
  echo "text: edit $f"; echo "text: lines like  AAPL 10 150.25"; exit 0
fi
lines=$(sed 's/#.*//' "$f" | awk 'NF>=2')
[ -z "$lines" ] && { echo "text: no holdings yet · edit $f"; exit 0; }
d=$(mktemp -d) || exit 0; trap 'rm -rf "$d"' EXIT
i=0; while read -r s q c; do i=$((i+1))
  ( curl -sf -m 6 -A Mozilla/5.0 "https://query1.finance.yahoo.com/v8/finance/chart/$s?interval=5m&range=1d" |
    sed -n 's/.*"regularMarketPrice":\([0-9.]*\).*"chartPreviousClose":\([0-9.]*\).*/\1 \2/p' > "$d/$i" ) &
done <<EOF
$lines
EOF
wait
echo "open: $f"
i=0; echo "$lines" | while read -r s q c; do i=$((i+1)); echo "$s $q ${c:--} $(cat "$d/$i" 2>/dev/null)"; done |
awk '
NF<5 { miss = miss " " $1; next }
{ v=$2*$4; val+=v; day+=$2*($4-$5); if ($3!="-") { cost+=$2*$3; cv+=v } }
END {
  if (val==0) { print "error: no prices (yahoo unreachable or bad symbols:" miss ")"; exit }
  printf "big: $%.2f\n", val
  printf "row: today | %+.2f  %+.2f%% | %s\n", day, day/(val-day)*100, (day<0)?"bad":"good"
  if (cost>0) printf "row: total P/L | %+.2f  %+.2f%% | %s\n", cv-cost, (cv-cost)/cost*100, (cv<cost)?"bad":"good"
  if (miss!="") print "text: no price for" miss
}'
exit 0
